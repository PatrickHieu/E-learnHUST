# =============================================================================
# ByteCraft / E-learnHUST — biến môi trường
# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon Postgres)
# -----------------------------------------------------------------------------
# Lấy pooled connection string từ dashboard Neon.
# Format: postgresql://<user>:<pass>@<host>/<db>?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# -----------------------------------------------------------------------------
# Bí mật để ký JWT. Sinh bằng: `openssl rand -base64 32`
AUTH_SECRET=

# (Tùy chọn) Đăng nhập Google. Lấy từ Google Cloud Console → OAuth 2.0 client.
# Redirect URI: {origin}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# -----------------------------------------------------------------------------
# Judge0 — chấm bài C / C++ / Python bằng test case stdin/stdout
# -----------------------------------------------------------------------------
# 1. Đăng ký tại https://rapidapi.com/judge0-official/api/judge0-ce/
#    chọn Basic (free, 50 submissions/ngày).
# 2. Copy X-RapidAPI-Key.
JUDGE0_RAPIDAPI_KEY=

# Các giá trị mặc định bên dưới đã đủ cho bài tập học, chỉ override khi cần.
JUDGE0_HOST=judge0-ce.p.rapidapi.com
JUDGE0_CPU_TIME=5
JUDGE0_WALL_TIME=8
JUDGE0_MEMORY_KB=256000

# -----------------------------------------------------------------------------
# Bootstrap admin (chỉ dùng cho `npm run bootstrap:admin`)
# -----------------------------------------------------------------------------
# Sau khi DB sạch, chạy script này để tạo tài khoản admin đầu tiên.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
